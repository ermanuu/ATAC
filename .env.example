# Non-secret backend URL reachable from the iPhone.
# Deployed backend: HTTPS. Expo Go trial on the same private Wi-Fi: PC LAN HTTP.
EXPO_PUBLIC_API_URL=https://your-backend.example

# Optional, backend only: current public snapshot written by the browser timer.
# Set this in the backend service environment, not as EXPO_PUBLIC_*.
# ATAC_METRO_SNAPSHOT=/opt/romabus/server/data/metro-browser.json
