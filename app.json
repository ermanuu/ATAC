{
  "expo": {
    "name": "ATAC",
    "slug": "ATAC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/atac-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/bus-front.png",
        "monochromeImage": "./assets/bus-front.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/atac-app-icon.png",
      "output": "single"
    },
    "scheme": "romabus",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bus-front.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
