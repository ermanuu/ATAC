[Unit]
Description=Verifica stato Metro ATAC tramite Firefox
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=romabus
Group=romabus
UMask=0077
WorkingDirectory=/opt/romabus
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/romabus-metro/browsers
Environment=XDG_CACHE_HOME=/var/lib/romabus-metro/cache
Environment=XDG_CONFIG_HOME=/var/lib/romabus-metro/config
Environment=XDG_STATE_HOME=/var/lib/romabus-metro/state
ExecStart=/opt/romabus/.venv/bin/python /opt/romabus/scripts/watch-atac-metro.py --profile /var/lib/romabus-metro/profile --output /opt/romabus/server/data/metro-browser.json
TimeoutStartSec=90
WatchdogSec=240s
WatchdogSignal=SIGKILL
Restart=on-failure
RestartSec=120s
RestartPreventExitStatus=3
KillMode=control-group
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/romabus-metro /opt/romabus/server/data

[Install]
WantedBy=multi-user.target
